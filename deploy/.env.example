# ---- Copy to deploy/.env and fill in. Never commit deploy/.env ----

# Public site URL (used for absolute links, e.g. the logo in contact emails)
SITE_URL=https://benichi.dev

# Admin panel credentials (login form at /admin/login)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-long-random

# Gmail SMTP for the contact form (use a Google "App Password", not your login)
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
CONTACT_RECEIVER=youraddress@gmail.com

# ---- Used only by deploy/init-letsencrypt.sh ----
LETSENCRYPT_EMAIL=you@example.com
# Set to 1 for the first run against Let's Encrypt staging to avoid rate limits
CERTBOT_STAGING=0
